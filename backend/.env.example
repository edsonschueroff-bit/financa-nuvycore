NODE_ENV=production
PORT=3005

# Banco de Dados MySQL
DB_HOST=localhost
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=financeiro
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# Autenticação JWT
JWT_SECRET=seu_jwt_secret_super_seguro

# Domínio e CORS
SYSTEM_DOMAIN=https://financas.nuvycore.online
CORS_ORIGIN=https://financas.nuvycore.online

# Chaves de Integração Nuvy Core
NUVY_INTEGRATION_KEY=sua_chave_integracao
NUVY_INTEGRATION_KEY_LEGADO=sua_chave_legado

# WhatsApp (Evolution API)
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=sua_evolution_api_key
EVOLUTION_INSTANCE=fin_empresa_1

# Inteligência Artificial (OpenAI)
OPENAI_API_KEY=sk-proj-sua_chave_openai

# Telegram Copilot (Cora)
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token
TELEGRAM_BOT_USERNAME=NuvyFinanceBot

# Asaas
ASAAS_WEBHOOK_TOKEN=seu_token_webhook_asaas

# SMTP (Envio de E-mails)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@exemplo.com
SMTP_PASS=sua_senha_smtp
SMTP_FROM="Nuvy Finance <nao-responda@nuvycore.online>"
